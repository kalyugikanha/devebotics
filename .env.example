# -----------------------------------------------------------------------------
# Softec Ai Solution — environment configuration (PLACEHOLDERS ONLY)
# Copy to .env and fill in real values. Never commit the real .env file.
# -----------------------------------------------------------------------------
APP_NAME="Softec Ai Solution"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Set to true only on the live production domain. Any other environment is
# always served with "noindex" regardless of admin SEO settings.
APP_ALLOW_INDEXING=false
# Force HTTPS URL generation + HSTS (production should be true).
APP_FORCE_HTTPS=false
# Reverse proxy IPs/CIDRs allowed to set X-Forwarded-* headers ("*" only if the app is reachable solely via the proxy).
TRUSTED_PROXIES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL / MariaDB. Use a least-privilege user in production
# (SELECT, INSERT, UPDATE, DELETE, CREATE, ALTER, INDEX, DROP, REFERENCES on this schema only).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=softec_ai
DB_USERNAME=softec_ai
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# true in production (HTTPS only cookies)
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Disk used for the public media library ("public" locally, "s3" for cloud storage).
MEDIA_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Outgoing mail. Credentials live here only — they are never shown in the admin panel.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# S3-compatible object storage (optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Cloudflare Turnstile bot protection (optional). The site key is public;
# the secret key must stay server-side.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional AI-assisted drafting for blog editors (drafts only, never auto-published).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Initial super administrator created by `php artisan db:seed`.
# Leave the password empty to have a random one generated and printed once.
SEED_ADMIN_NAME="Super Admin"
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=

# Backups (spatie/laravel-backup): database + storage/app uploads.
# BACKUP_DISK may list several disks, e.g. "local,s3". Set an archive password to encrypt backup zips.
BACKUP_NAME=softec-ai-solution
BACKUP_DISK=local
BACKUP_ARCHIVE_PASSWORD=
BACKUP_NOTIFICATION_EMAIL=

VITE_APP_NAME="${APP_NAME}"
